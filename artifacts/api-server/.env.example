# ── SMTP (required for email invites) ───────────────────────
# See SETUP.md Step 4 for provider-specific instructions

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM=DeployDash <you@gmail.com>

# ── API key (admins enter this in the UI when sending invites)
# Generate a strong random string: openssl rand -hex 32
INVITE_API_KEY=change-me-to-a-long-random-secret

# ── Optional ─────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# ── CORS (set to your frontend URL in production) ────────────
# FRONTEND_URL=https://your-app.vercel.app
