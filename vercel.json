{
  "buildCommand": "pnpm --filter @workspace/deployment-dashboard run build",
  "outputDirectory": "public",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!assets|favicon\\.svg|robots\\.txt|opengraph\\.jpg).*)", "destination": "/index.html" }
  ]
}
